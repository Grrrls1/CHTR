{
  "training_mode": "single_stroke_xy_width_v1",
  "dataset": "data/chtr_mmah_lmdb",
  "split_file": "models/data_splits/full_character_v1.json",
  "output_dir": "models/runs/single_stroke_smoke_v1/train",
  "seed": 42,
  "device": "auto",
  "threads": 2,
  "batch_size": 2,
  "epochs": 20,
  "max_steps": 4,
  "train_char_limit": 32,
  "train_stroke_limit": 8,
  "eval_strokes": 2,
  "eval_every_steps": 4,
  "augment": false,
  "learning_rate": 0.0001,
  "weight_decay": 0.0,
  "width_weight": 1.0,
  "valid_weight": 0.2,
  "grad_clip": 1.0,
  "model": {
    "dim": 32,
    "heads": 4,
    "encoder_layers": 1,
    "decoder_layers": 4,
    "max_points": 4096,
    "dropout": 0.0
  }
}
