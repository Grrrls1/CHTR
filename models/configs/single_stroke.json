{
  "training_mode": "single_stroke_xy_width_v1",
  "dataset": "data/chtr_mmah_lmdb",
  "split_file": "models/data_splits/full_character_v1.json",
  "output_dir": "models/runs/single_stroke",
  "seed": 42,
  "device": "auto",
  "threads": 4,
  "batch_size": 96,
  "epochs": 200,
  "max_steps": 0,
  "train_char_limit": 0,
  "train_stroke_limit": 0,
  "augment": false,
  "learning_rate": 0.0003,
  "weight_decay": 0.0,
  "width_weight": 1.0,
  "valid_weight": 0.2,
  "grad_clip": 1.0,
  "model": {
    "dim": 64,
    "heads": 4,
    "encoder_layers": 2,
    "decoder_layers": 4,
    "max_points": 400,
    "dropout": 0.0
  },
  "optimizer": "adamw",
  "cosine_steps": 0,
  "checkpoint_every": 100,
  "early_stopping": {
    "patience": 10,
    "min_delta": 0.001,
    "min_epochs": 20
  },
  "evaluation_protocol": "full_split_free_v2",
  "eval_every_epochs": 10,
  "eval_batch_size": 32,
  "visualize_characters": 30,
  "decode_max_points": 400,
  "validity_threshold": 0.5,
  "final_test": true
}
